<mujoco model="humanoid_full_body">
  <compiler angle="degree" inertiafromgeom="true"/>
  <default>
    <joint armature="0.02" damping="5" limited="true"/>
    <geom conaffinity="1" condim="3" friction="1.2 0.6 0.6" margin="0.01"
          material="body_mat" rgba="0.8 0.6 0.4 1"/>
    <motor ctrllimited="true" ctrlrange="-1.0 1.0"/>
  </default>

  <option integrator="RK4" iterations="50" solver="PGS" timestep="0.003"/>

  <visual>
    <map force="0.1" zfar="30"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <quality shadowsize="0"/>
    <global offwidth="800" offheight="600"/>
  </visual>

  <asset>
    <texture builtin="flat" height="127" mark="cross" markrgb="1 1 1" name="texgeom"
             random="0.01" rgb1="0.8 0.6 0.4" rgb2="0.8 0.6 0.4" type="cube" width="127"/>
    <material name="body_mat" texture="texgeom" texuniform="true"/>
    <material name="floor_mat" rgba="0.85 0.85 0.85 1" reflectance="0.1"/>
    <material name="head_mat" rgba="0.9 0.75 0.6 1"/>
  </asset>

  <worldbody>
    <light cutoff="100" diffuse="1 1 1" dir="0 0 -1.3" directional="true" exponent="1"
           pos="0 0 1.3" specular="0.1 0.1 0.1"/>
    <geom conaffinity="1" condim="3" material="floor_mat" name="floor" pos="0 0 0"
          rgba="0.9 0.9 0.9 1" size="40 40 1" type="plane"/>

    <!-- 骨盆：根 body，站立高度 ~0.88（与 lower_body 一致） -->
    <body name="pelvis" pos="0 0 0.88">
      <camera name="track" mode="trackcom" pos="0 -3.0 0.8" xyaxes="1 0 0 0 0.3 1"/>
      <freejoint name="root"/>
      <geom name="pelvis_geom" type="box" size="0.09 0.11 0.07" mass="8.0"/>

      <!-- ===== 上半身：躯干经腰关节连接骨盆 ===== -->
      <body name="torso" pos="0 0 0.07">
        <joint name="waist_y" axis="0 1 0" range="-30 30" pos="0 0 0"/>
        <joint name="waist_x" axis="1 0 0" range="-20 20" pos="0 0 0"/>
        <geom name="torso_geom" type="box" pos="0 0 0.14" size="0.1 0.12 0.15" mass="12.0"/>

        <!-- 右臂 -->
        <body name="right_upper_arm" pos="0 -0.16 0.26">
          <joint name="right_shoulder_y" axis="0 1 0" range="-120 120" pos="0 0 0"/>
          <joint name="right_shoulder_x" axis="1 0 0" range="-90 30" pos="0 0 0"/>
          <geom name="right_uarm_geom" type="capsule" fromto="0 0 0 0 0 -0.28"
                size="0.035" mass="2.0"/>
          <body name="right_lower_arm" pos="0 0 -0.28">
            <joint name="right_elbow" axis="0 1 0" range="0 120" pos="0 0 0"/>
            <geom name="right_larm_geom" type="capsule" fromto="0 0 0 0 0 -0.25"
                  size="0.03" mass="1.5"/>
          </body>
        </body>

        <!-- 左臂 -->
        <body name="left_upper_arm" pos="0 0.16 0.26">
          <joint name="left_shoulder_y" axis="0 1 0" range="-120 120" pos="0 0 0"/>
          <joint name="left_shoulder_x" axis="1 0 0" range="-30 90" pos="0 0 0"/>
          <geom name="left_uarm_geom" type="capsule" fromto="0 0 0 0 0 -0.28"
                size="0.035" mass="2.0"/>
          <body name="left_lower_arm" pos="0 0 -0.28">
            <joint name="left_elbow" axis="0 1 0" range="0 120" pos="0 0 0"/>
            <geom name="left_larm_geom" type="capsule" fromto="0 0 0 0 0 -0.25"
                  size="0.03" mass="1.5"/>
          </body>
        </body>

        <!-- 脖子 + 头 -->
        <body name="head" pos="0 0 0.38">
          <joint name="neck_y" axis="0 1 0" range="-30 30" pos="0 0 -0.08"/>
          <joint name="neck_x" axis="1 0 0" range="-30 30" pos="0 0 -0.08"/>
          <geom name="neck_geom" type="capsule" fromto="0 0 -0.08 0 0 -0.02"
                size="0.03" mass="0.8"/>
          <geom name="head_geom" type="sphere" pos="0 0 0.06" size="0.09"
                mass="4.0" material="head_mat"/>
          <!-- 鼻子：朝 +x，标示脸的朝向（与脚尖同向） -->
          <geom name="nose_geom" type="capsule" fromto="0.08 0 0.06 0.12 0 0.04"
                size="0.018" mass="0.05" rgba="0.9 0.5 0.4 1"/>
        </body>
      </body>

      <!-- ===== 下半身：与 lower_body 完全一致 ===== -->
      <body name="right_thigh" pos="0 -0.09 -0.07">
        <joint name="right_hip_y" axis="0 1 0" range="-90 40" pos="0 0 0"/>
        <geom name="right_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.38"
              size="0.055" mass="5.0"/>
        <body name="right_shin" pos="0 0 -0.38">
          <joint name="right_knee" axis="0 1 0" range="0 140" pos="0 0 0"/>
          <geom name="right_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.38"
                size="0.045" mass="3.5"/>
          <body name="right_foot" pos="0 0 -0.38">
            <joint name="right_ankle_y" axis="0 1 0" range="-45 45" pos="0 0 0"/>
            <geom name="right_foot_geom" type="box" pos="0.03 0 -0.03"
                  size="0.11 0.055 0.03" mass="1.2"/>
          </body>
        </body>
      </body>

      <body name="left_thigh" pos="0 0.09 -0.07">
        <joint name="left_hip_y" axis="0 1 0" range="-90 40" pos="0 0 0"/>
        <geom name="left_thigh_geom" type="capsule" fromto="0 0 0 0 0 -0.38"
              size="0.055" mass="5.0"/>
        <body name="left_shin" pos="0 0 -0.38">
          <joint name="left_knee" axis="0 1 0" range="0 140" pos="0 0 0"/>
          <geom name="left_shin_geom" type="capsule" fromto="0 0 0 0 0 -0.38"
                size="0.045" mass="3.5"/>
          <body name="left_foot" pos="0 0 -0.38">
            <joint name="left_ankle_y" axis="0 1 0" range="-45 45" pos="0 0 0"/>
            <geom name="left_foot_geom" type="box" pos="0.03 0 -0.03"
                  size="0.11 0.055 0.03" mass="1.2"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <!-- 下半身 -->
    <motor name="right_hip_y_motor" joint="right_hip_y" gear="80"/>
    <motor name="right_knee_motor" joint="right_knee" gear="80"/>
    <motor name="right_ankle_y_motor" joint="right_ankle_y" gear="40"/>
    <motor name="left_hip_y_motor" joint="left_hip_y" gear="80"/>
    <motor name="left_knee_motor" joint="left_knee" gear="80"/>
    <motor name="left_ankle_y_motor" joint="left_ankle_y" gear="40"/>
    <!-- 腰 -->
    <motor name="waist_y_motor" joint="waist_y" gear="60"/>
    <motor name="waist_x_motor" joint="waist_x" gear="60"/>
    <!-- 右臂 -->
    <motor name="right_shoulder_y_motor" joint="right_shoulder_y" gear="30"/>
    <motor name="right_shoulder_x_motor" joint="right_shoulder_x" gear="30"/>
    <motor name="right_elbow_motor" joint="right_elbow" gear="20"/>
    <!-- 左臂 -->
    <motor name="left_shoulder_y_motor" joint="left_shoulder_y" gear="30"/>
    <motor name="left_shoulder_x_motor" joint="left_shoulder_x" gear="30"/>
    <motor name="left_elbow_motor" joint="left_elbow" gear="20"/>
    <!-- 脖子 -->
    <motor name="neck_y_motor" joint="neck_y" gear="10"/>
    <motor name="neck_x_motor" joint="neck_x" gear="10"/>
  </actuator>
</mujoco>
